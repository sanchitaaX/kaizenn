# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# --- GitHub sign-in (OAuth App). Leave the client id empty to use demo sign-in. ---
# Create the app at https://github.com/settings/developers  (see docs/SETUP_GITHUB.md)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must match the "Authorization callback URL" of the OAuth App exactly, including host and port.
GITHUB_REDIRECT_URI=http://localhost:8000/auth/callback
# "repo" lets KAIZEN read private repos and open fix pull requests.
# Use "read:user public_repo" if you only scan public repos.
GITHUB_SCOPES=read:user repo security_events

# --- Sessions ---
# Signs the session cookie. Set a fixed value so sign-ins survive a server restart:
#   .venv/Scripts/python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# --- Storage ---
DATABASE_PATH=securefix.db
# Every live engine run is saved here so it can be replayed on stage.
RUNS_DIR=runs

# --- Demo ---
# 1 = seed the database with demo data, allow /auth/demo and /api/demo/reset.
# Set to 0 when you only want real GitHub accounts.
DEMO_MODE=1

# --- Engine ---
# auto = replay a saved or demo run when one exists, otherwise run live. Also: replay, live.
ENGINE_MODE=auto
# Seconds between lights when a run is replayed.
SCAN_STEP_DELAY=1.2
# Local checkout of the demo repo that Semgrep and Bandit scan in live mode.
ENGINE_SOURCE_DIR=

# --- AI (any OpenAI-compatible API; optional, features fall back to non-AI answers without a key) ---
# Groq (what the team uses):
#   OPENAI_API_KEY=gsk_...   OPENAI_MODEL=openai/gpt-oss-120b   OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OpenAI:
#   OPENAI_API_KEY=sk-...    OPENAI_MODEL=gpt-4o-mini           OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-oss-120b
OPENAI_BASE_URL=https://api.groq.com/openai/v1
